# ---------------------------------------------------------------------------
# AI Music Short Studio — environment configuration
#
# Everything below is OPTIONAL. With no configuration at all the studio runs
# end-to-end using the built-in offline providers, so the whole
# generate -> review -> approve -> assemble -> export flow is testable without
# any cloud credentials.
# ---------------------------------------------------------------------------

# HTTP port for the API + static asset server.
PORT=8787

# Where projects, generations and exports are stored on disk.
# Defaults to <repo>/data
AMS_DATA_DIR=

# --- Generation providers ---------------------------------------------------
# Each provider can be set independently to "mock" or its cloud implementation.
#   AMS_IMAGE_PROVIDER   mock | vertex
#   AMS_VIDEO_PROVIDER   mock | vertex
#   AMS_MUSIC_PROVIDER   mock | lyria
#   AMS_AMBIENT_PROVIDER mock
AMS_IMAGE_PROVIDER=mock
AMS_VIDEO_PROVIDER=mock
AMS_MUSIC_PROVIDER=mock
AMS_AMBIENT_PROVIDER=mock

# --- Google Cloud / Vertex AI (images + video + Lyria music) ----------------
# Authentication uses Application Default Credentials:
#   gcloud auth application-default login
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account key file.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AMS_VERTEX_IMAGE_MODEL=imagen-4.0-generate-001
AMS_VERTEX_VIDEO_MODEL=veo-3.0-generate-001
# The PRD calls the music model "Lyra"; on Vertex AI the instrumental
# music model is published as Lyria.
AMS_VERTEX_MUSIC_MODEL=lyria-002

# --- Creative planning (the AI production team) -----------------------------
# When an Anthropic API key is present the Director / Art Director / DP write
# the creative brief with Claude. Without it the studio falls back to the
# built-in deterministic planner, which produces a complete plan offline.
AMS_PLANNER=auto        # auto | claude | heuristic
ANTHROPIC_API_KEY=
AMS_PLANNER_MODEL=claude-opus-5
