# ---------------------------------------------------------------------------
# AI Music Short Studio — variables de entorno
#
# Se ponen en Vercel: Settings -> Environment Variables. Después hay que
# volver a desplegar (Redeploy): Vercel no aplica variables nuevas a un
# despliegue ya construido.
#
# CAMBIAR DE CUENTA DE GOOGLE CLOUD = cambiar las dos primeras y redeployar.
# No hay ningún identificador de proyecto, bucket, modelo ni región escrito en
# el código: el proyecto sale del "project_id" de la propia credencial.
# ---------------------------------------------------------------------------

# ── OBLIGATORIAS ───────────────────────────────────────────────────────────

# El JSON completo de la cuenta de servicio, tal cual se descarga de Google
# Cloud. Vale en una sola línea o con saltos. También se acepta el mismo JSON
# en base64, que es más cómodo de pegar desde un móvil.
GCP_SERVICE_ACCOUNT=

# El nombre del bucket, SIN "gs://" y sin barras.
GCS_OUTPUT_BUCKET=

# ── MUY RECOMENDADA ────────────────────────────────────────────────────────

# La contraseña de la aplicación. Sin ella, en producción la API queda cerrada
# a propósito: generar un corto son decenas de llamadas a Veo, así que una API
# abierta es dinero regalado a quien encuentre la dirección.
# Genera una larga y guárdala. Por ejemplo:  openssl rand -hex 24
APP_KEY=

# ── OPCIONALES ─────────────────────────────────────────────────────────────

# La capa creativa (concepto, biblia visual, descripción de cada toma) la
# escribe Claude si hay clave. Sin ella se usa el planificador interno, que es
# determinista y funciona igual de bien: es un modo válido, no un fallo.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-5-20251101

# Carpeta propia dentro del bucket, por si lo compartes con otro proyecto.
# GCS_PREFIX=music-studio

# Región por defecto para todo lo de Vertex AI.
# GCP_LOCATION=us-central1

# Los modelos. Solo hace falta tocar alguno si tu proyecto no tiene acceso a
# él: el que configures es el que se usa, y si falla verás el error de Google
# tal cual. Nunca se sustituye un modelo por otro a tus espaldas.
# IMAGE_MODEL=imagen-4.0-generate-001
# VEO_MODEL=veo-3.1-lite-generate-001
# MUSIC_MODEL=lyria-002

# Región donde corre el montaje del MP4 (Cloud Build).
# MONTAJE_REGION=us-central1

# La imagen de contenedor que aporta ffmpeg al montaje. Solo por si algún día
# desaparece la de por defecto.
# FFMPEG_IMAGE=alpine:3.20
